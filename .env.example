# ==============================================================================
# TaskFlow Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application
PROJECT_NAME="TaskFlow API"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

# Security & Authentication
SECRET_KEY="super-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database (Async for FastAPI, Sync for Celery / Alembic)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_password
POSTGRES_DB=taskflow_db
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow_password@localhost:5432/taskflow_db
SYNC_DATABASE_URL=postgresql://taskflow:taskflow_password@localhost:5432/taskflow_db

# Redis & Caching
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Celery Background Workers
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_BEAT_SCHEDULE_SECONDS=60

# Observability
LOG_LEVEL=INFO
ENABLE_PROMETHEUS_METRICS=True
